# La billetera, reservas y pagos siguen siendo simulados.
VITE_DATA_MODE=demo
# Cambia a live para consultar los estacionamientos reales sin activar pagos reales.
VITE_OCCUPANCY_MODE=demo
# URL vacía: Vite reenvía /api al NestJS local durante desarrollo.
VITE_API_URL=
VITE_SPACES_PATH=/api/estacionamientos
# Solo respaldo si WebSocket no está conectado o falla la sincronización.
VITE_POLL_INTERVAL_MS=3000
# Opcional: origen del Socket.IO cuando no se usa el proxy del frontend.
# VITE_SOCKET_URL=http://127.0.0.1:3000
# El firmware envía un reporte cada 30 s; margen de tres reportes.
VITE_STALE_AFTER_MS=90000

# Streaming MJPEG desde UVC Camera (PC en la misma red local).
# Si se omite la variable, toma el HOST de la pagina y usa el puerto 8765;
# por ejemplo http://192.168.1.14:5173 -> http://192.168.1.14:8765/video.
# En HTTPS se requiere un proxy HTTPS para evitar contenido mixto.
# VITE_CAMERA_ENTRADA_URL=http://192.168.1.14:8765
# Cámara 02 W77: aparece siempre en Seguridad. Si está desconectada,
# mostrará "Sin conexión" y NO afecta a la primera cámara.
# Por defecto busca la W77 en el mismo HOST del frontend, puerto 8766.
# Si la W77 transmite desde otra computadora, especificar su IP privada:
# VITE_CAMERA_SALIDA_URL=http://192.168.1.50:8766

# API de cuentas: mismo origen mediante proxy Vite; en despliegue usar HTTPS.
# VITE_ACCOUNT_API_URL=/api
